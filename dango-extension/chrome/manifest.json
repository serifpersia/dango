{
  "manifest_version": 3,
  "name": "Dango Helper",
  "version": "0.3.0",
  "description": "Supplies provider verification cookies (cf_clearance and site cookies) and YouTube Music cookies to Dango.",
  "permissions": ["cookies", "webRequest"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "https://animepahe.pw/*",
    "https://japaneseasmr.com/*",
    "https://*.japaneseasmr.com/*",
    "https://music.youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
