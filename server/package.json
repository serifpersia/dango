{
  "name": "dango-server",
  "private": true,
  "version": "2.7.6",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --max-old-space-size=256 dist/server.js",
    "dev": "nodemon --watch \"src/**/*.ts\" --exec \"ts-node --transpile-only src/server.ts --dev\"",
    "build": "tsc",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@octokit/auth-oauth-device": "^8.0.3",
    "@octokit/rest": "^22.0.1",
    "@xhayper/discord-rpc": "^1.3.4",
    "axios": "^1.15.1",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "freekeys": "^0.0.4",
    "got-scraping": "^3.2.9",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.1",
    "ws": "^8.18.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.10",
    "@types/xml2js": "^0.4.14",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2",
    "glob": "^13.0.0"
  }
}
