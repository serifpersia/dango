{
  "name": "@serifpersia/dango",
  "version": "3.0.8",
  "description": "A web application for watching anime.",
  "main": "orchestrator.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serifpersia/dango.git"
  },
  "bin": {
    "dango": "orchestrator.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node -e \"if(!String(process.env.npm_config_user_agent||'').startsWith('pnpm/')){console.error('[dango] Use pnpm, not npm. Run: pnpm run build');process.exit(1)}\"",
    "prelint": "node -e \"if(!String(process.env.npm_config_user_agent||'').startsWith('pnpm/')){console.error('[dango] Use pnpm, not npm. Run: pnpm run lint');process.exit(1)}\"",
    "preformat": "node -e \"if(!String(process.env.npm_config_user_agent||'').startsWith('pnpm/')){console.error('[dango] Use pnpm, not npm. Run: pnpm run format');process.exit(1)}\"",
    "build": "pnpm -r run build",
    "start": "node orchestrator.js prod",
    "dev": "node orchestrator.js dev",
    "client": "pnpm --filter dango-client run start",
    "server": "pnpm --filter dango-server run start",
    "preview": "node orchestrator.js prod",
    "test": "pnpm --filter dango-client run test",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "prepublishOnly": "node sync-deps.js && pnpm run build",
    "update-version": "node update-version.js"
  },
  "files": [
    "orchestrator.js",
    "client/dist",
    "server/dist",
    "server/package.json",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "anime",
    "react",
    "express",
    "typescript",
    "streaming",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "packageManager": "pnpm@11.27.0",
  "dependencies": {
    "@octokit/auth-oauth-device": "^8.0.3",
    "@octokit/rest": "^22.0.1",
    "@xhayper/discord-rpc": "^1.3.4",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "got-scraping": "^3.2.9",
    "lru-cache": "^11.5.2",
    "multer": "^2.0.2",
    "pino": "^10.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "versionDate": "2026-09-15T14:44:02.005Z"
}
